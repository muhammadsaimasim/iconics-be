PORT=5000
# Loopback only; nginx proxies /api and /uploads. Never expose this port publicly.
HOST=127.0.0.1
NODE_ENV=production
# Number of reverse proxies in front of Express (nginx = 1)
TRUST_PROXY_HOPS=1

SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Private bucket for registrant documents; public bucket for site images
SUPABASE_PRIVATE_BUCKET=registerations
SUPABASE_PUBLIC_BUCKET=public-assets

DATABASE_URL=
DIRECT_URL=

CLIENT_URL=https://iconics.neduet.edu.pk

# Required, at least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Admin accounts are stored in the database. Create one with:
#   node scripts/create-admin.js you@neduet.edu.pk "Your Name"
